# =============================================================================
# TITAN-GYM — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves reais
# =============================================================================

# ---------------------------------------------------------------
# SUPABASE — Banco de Dados em Nuvem (Local-First Sync)
# ---------------------------------------------------------------
# 1. Acesse: https://supabase.com/dashboard/project/huzgvvrsngfeubfzztsk
# 2. Vá em Settings → API
# 3. Copie a "anon public" key abaixo:
VITE_SUPABASE_URL="https://huzgvvrsngfeubfzztsk.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------
# REVENUECAT — Google Play Billing (Assinaturas PRO)
# ---------------------------------------------------------------
# 1. Acesse: https://app.revenuecat.com/
# 2. Crie um app para Google Play → copie a "Public API Key"
# 3. Configure os produtos: titan_pro_monthly / titan_pro_annual
# 4. Configure entitlement: "pro"
VITE_REVENUECAT_GOOGLE_KEY=""
